# Hugo build output — never edited by hand, never committed.
/public/
# Hugo resource cache + local scratch (incl. large source downloads like the
# Colorplan swatch ZIP, which is not a build input — see the Colorplan section
# of CLAUDE.md). The committed palette source is scripts/colorplan-source.json.
/resources/
.hugo_build.lock

# Deploy credentials / targets live outside the repo.
deploy.env

# Library — a hosted third-party file whose rights status is `review` must NOT
# enter the public repo (committing is itself distribution). List such files
# here while their entry stays a draft; remove the line once the file has a
# publishable rights basis (e.g. `archival`) and is meant to ship. See
# CLAUDE.md § Library.

# OS / editor cruft
.DS_Store
*.swp
Thumbs.db

# Claude Code local/personal settings (machine-specific tool permissions) —
# .claude/agents/ (shared project subagent definitions) IS committed.
.claude/settings.local.json
