{{- /* /library/<collection>/index.json (root: /library/index.json — see
       Phase 3) — normalized public Collection data (docs/library-v2.md § 4).
       Every PUBLISHED entry belonging to THIS Collection (in-section +
       cross-site), display-ready so the client scripts need no vocabulary
       lookups. No filesystem paths, no drafts, no rights-review working
       notes. */ -}}
{{- $lib := hugo.Data.library -}}
{{- $typeLabels := dict }}{{ range $lib.types }}{{ $typeLabels = merge $typeLabels (dict .type .label) }}{{ end -}}
{{- $subjectLabels := dict }}{{ range $lib.subjects }}{{ $subjectLabels = merge $subjectLabels (dict .subject .label) }}{{ end -}}
{{- $extKind := dict }}{{ range $lib.access_kinds }}{{ $extKind = merge $extKind (dict .kind .external) }}{{ end -}}

{{- /* Which Collection is this list page? Not hardcoded — resolved from the
       registry, so the same template serves any Collection's own
       index.json once Phase 4 gives each its own section. Exactly one
       match today (research). */ -}}
{{- $coll := partial "library-resolve-collection.html" . -}}

{{- /* The Library root itself (the meta-Collection) has no gathered Hugo
       Entries of its own to run through library-collect.html — its
       "entries" are the registered child Collections. Full root rendering
       (Collection-summary entries) lands in Phase 3; this is a safe,
       non-erroring stub so Phase 4's route migration alone still builds
       and serves valid (empty) JSON at /library/index.json. */ -}}
{{- if eq $coll.source.adapter "root" -}}
{{ dict
    "collection" (dict "id" $coll.id "title" $coll.title "color" "" "description" "")
    "count" 0
    "entries" (slice)
    "public_type_styles" (dict)
    "relation_inverse" (dict)
    "relation_category" (dict)
  | jsonify (dict "indent" "  ") }}
{{- else -}}

{{- /* The one centralized specific-type -> public-type mapping (colors,
       shapes, labels) — see partials/library-public-types.html and
       data/library.yaml's public_types for the single canonical definition,
       also consumed by library-filters.html (chip swatches) and
       assets/js/library-map.js (node fill/shape) via this file's exported
       `public_type` per entry and top-level `public_type_styles`. */ -}}
{{- $pt := partialCached "library-public-types.html" . "library-public-types" -}}
{{- $entries := partial "library-collect.html" (dict "ctx" . "sectionPath" $coll.source.section "collection" $coll.id) -}}
{{- $out := slice -}}
{{- range $entries -}}
  {{- $p := . -}}
  {{- $type := "" }}{{ with .Params.library }}{{ $type = .type }}{{ end -}}

  {{- /* creators (resolve refs to urls) */ -}}
  {{- $creators := slice }}{{ $names := slice -}}
  {{- range .Params.creators -}}
    {{- $url := "" }}{{ with .ref }}{{ with (where site.RegularPages "Params.library.id" .) }}{{ $url = (index . 0).RelPermalink }}{{ end }}{{ end -}}
    {{- $creators = $creators | append (dict "name" .name "role" (.role | default "") "ref" (.ref | default "") "url" $url) -}}
    {{- $names = $names | append .name -}}
  {{- end -}}

  {{- /* subjects */ -}}
  {{- $subLabels := slice }}{{ range .Params.subjects }}{{ $subLabels = $subLabels | append (index $subjectLabels . | default .) }}{{ end -}}

  {{- /* primary image */ -}}
  {{- $img := "" -}}
  {{- $im0 := index .Params.images 0 }}{{ with $im0 }}{{ $anchor := $im0.anchor | default "Center" }}{{ $pos := partial "library-image-pos.html" $anchor }}{{ with ($p.Resources.GetMatch .file) }}{{ $t := .Fill (printf "360x360 %s q80" $anchor) }}{{ $img = dict "url" $t.RelPermalink "width" $t.Width "height" $t.Height "alt" ($im0.alt | default "") "pos" $pos }}{{ end }}{{ end -}}

  {{- /* access */ -}}
  {{- $access := slice -}}
  {{- range .Params.access -}}
    {{- $a := . -}}
    {{- if eq $a.kind "hosted-file" }}{{ with ($p.Resources.GetMatch ($a.file | default "")) }}{{ $access = $access | append (dict "label" ($a.label | default "Download") "kind" "hosted-file" "url" .RelPermalink "external" false) }}{{ end }}
    {{- else }}{{ with $a.url }}{{ $access = $access | append (dict "label" ($a.label | default "Link") "kind" ($a.kind | default "other") "url" . "external" (index $extKind ($a.kind | default "other") | default true)) }}{{ end }}{{ end -}}
  {{- end -}}

  {{- /* related — {ref, relation}, one entry per declaration (forward direction
         only; the reverse/inverse shown on the target entry's own page is a
         display-only convention in library-related.html, not a second stored
         edge, so this never double-counts a relationship). */ -}}
  {{- $related := slice -}}
  {{- range .Params.related -}}
    {{- $rel := . -}}
    {{- with $rel.ref }}{{ $related = $related | append (dict "ref" . "relation" ($rel.relation | default "")) }}{{ end -}}
  {{- end -}}

  {{- $rec := dict
      "library_id" .Params.library.id
      "title" .Title
      "url" .RelPermalink
      "type" $type
      "type_label" (index $typeLabels $type | default $type)
      "public_type" (index $pt.typeOf $type)
      "sarc_work" (eq .Params.library.sarc_work true)
      "summary" (.Params.summary | default "")
      "year" (.Params.year | default (cond .Date.IsZero "" (string .Date.Year)))
      "creators" $creators
      "creator_names" (delimit $names ", ")
      "subjects" (.Params.subjects | default slice)
      "subject_labels" $subLabels
      "primary_image" $img
      "access" $access
      "related" $related -}}
  {{- $out = $out | append $rec -}}
{{- end -}}
{{- $collOut := dict
    "id" $coll.id
    "title" $coll.title
    "color" $coll.color
    "description" ($coll.description | default "") -}}
{{ dict
    "collection" $collOut
    "count" (len $out)
    "entries" $out
    "public_type_styles" $pt.styles
    "relation_inverse" $lib.relation_inverse
    "relation_category" $lib.relation_categories
  | jsonify (dict "indent" "  ") }}
{{- end -}}
